{
  "name": "opensource-literature-mcp",
  "version": "0.1.0",
  "description": "MCP server for automatic literature discovery and screening across OpenAlex, Semantic Scholar, and arXiv.",
  "type": "module",
  "bin": {
    "opensource-literature-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.2.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "openalex",
    "semantic-scholar",
    "arxiv",
    "literature-review"
  ],
  "license": "MIT"
}
